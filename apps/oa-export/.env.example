# 服务器上保存为 C:\lab-workspace\config\oa.env，仅 SYSTEM 和管理员可读。
# 不要把真实配置放入安装包；现有根目录 .env 的 oa_url_materials/user/password 也可读取。
OA_URL=https://oa.example.invalid/
OA_USERNAME=example-user
OA_PASSWORD=replace-locally
OA_USERNAME_SELECTOR='#login_username'
OA_PASSWORD_SELECTOR='#login_password1'
OA_LOGIN_SELECTOR='#login_button'
OA_LOGIN_SUCCESS_SELECTOR='.lev1Title[title="采购管理"]'
# 仅用于关闭登录后的非强制提示；提示取消后不可继续访问时，程序会失败退出。
OA_LOGIN_DISMISS_SELECTOR='#btn2_btn'
OA_NAVIGATION_STEPS='[{"action":"hover","selector":".lev1Title[title=\"采购管理\"]"},{"action":"click","selector":".lev2Title[title=\"部门物料\"]"}]'
OA_EXPORT_FRAMES='["#mainIframe","#data-iframe"]'
OA_EXPORT_SELECTOR='button:has-text("导出")'
OA_BROWSER_CHANNEL=msedge
OA_OUTPUT_DIR=E:\lab-workspace\oa-materials
# 设置后导出成功即增量入库；须先完成工作台迁移。留空时只导出。
OA_LAB_ENV_FILE=C:\lab-workspace\config\lab.env
OA_TIMEOUT_MS=60000
OA_DOWNLOAD_TIMEOUT_MS=180000
